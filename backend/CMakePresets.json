{
  "version": 5,
  "configurePresets": [
    {
      "name": "docker",
      "displayName": "Debug backend",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USERVER_INSTALL": "OFF",
        "USERVER_USE_STATIC_LIBS": "OFF",
        "USERVER_BUILD_TESTS": "OFF",
        "USERVER_BUILD_SAMPLES": "OFF",
        "USERVER_FEATURE_UTEST": "OFF",
        "USERVER_FEATURE_POSTGRESQL": "ON",
        "USERVER_FEATURE_PATCH_LIBPQ": "OFF",
        "USERVER_USE_CCACHE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "docker",
      "configurePreset": "docker",
      "targets": ["community_treasury_backend"],
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "docker",
      "configurePreset": "docker",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
